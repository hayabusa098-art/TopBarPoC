<Window x:Class="TopBarPoC.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Height="32"
        Width="1920"
        Title="TopBar"
        Background="Transparent">
    <Window.Resources>

        <Style x:Key="LauncherButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#788890"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Ellipse x:Name="hoverDot"
                                         Width="3" Height="3"
                                         Fill="#7899A2"
                                         Stroke="#A6C0C7"
                                         StrokeThickness="0.5"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,2"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#17FFFFFF"/>
                                <Setter TargetName="hoverDot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#0DFFFFFF"/>
            <Setter Property="Foreground"      Value="#8CC8CDD6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="MinWidth"        Value="52"/>
            <Setter Property="MaxWidth"        Value="120"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- icon column: collapses automatically when Source is null -->
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="13" Height="13"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Margin"     Value="0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock x:Name="label"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Content}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"/>
                                <Rectangle x:Name="activeDot"
                                           Grid.ColumnSpan="2"
                                           Width="18" Height="2"
                                           RadiusX="1" RadiusY="1"
                                           Fill="#86A8B1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,2"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#17FFFFFF"/>
                                <Setter TargetName="label"  Property="Foreground" Value="#F2F4F7"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            From="#0DFFFFFF" To="#17FFFFFF"
                                                            Duration="0:0:0.08"/>
                                            <ColorAnimation Storyboard.TargetName="label"
                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            From="#8CC8CDD6" To="#F2F4F7"
                                                            Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            From="#17FFFFFF" To="#0DFFFFFF"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="label"
                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            From="#F2F4F7" To="#8CC8CDD6"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="activeDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background"       Value="#293DDC97"/>
                                <Setter TargetName="border" Property="BorderBrush"      Value="#593DDC97"/>
                                <Setter TargetName="border" Property="BorderThickness"  Value="1"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="border" Property="Background"  Value="#333DDC97"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6B3DDC97"/>
                                <Setter TargetName="label"  Property="Foreground"  Value="#EEF1F5"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0E1318"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#B8BCBE"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2224"/>
                                <Setter Property="Foreground" Value="#A6C0C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupedSelectorCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7C8082"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC2222"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#2A3033"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
        Layout: DockPanel
          Right (Dock=Right): date / time / exit — docked first, always claims natural width,
                              cannot be displaced by center content growth.
          Fill (Grid):        launcher + separator + chips — receives all remaining space;
                              HorizontalAlignment="Center" centers content within that area;
                              ClipToBounds="True" clips any overflow inward, never rightward.
        Trade-off: center point is (barWidth - rightGroupWidth) / 2 from left, not barWidth / 2.
        On ≥1080 px monitors the ~77 px offset is not noticeable. Right group safety is guaranteed.
    -->
    <Border Margin="0"
            Padding="4,0,2,0"
            BorderThickness="0,0,0,1"
            CornerRadius="0,0,12,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#19303A" Offset="0"/>
                <GradientStop Color="#0E151B" Offset="0.35"/>
                <GradientStop Color="#0A0C10" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#12FFFFFF"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="0"
                              Color="#000000"
                              Opacity="0.35"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <Rectangle DockPanel.Dock="Top" Height="1" Fill="#1FFFFFFF" IsHitTestVisible="False"/>

        <!-- ── RIGHT GROUP ── date / time / exit (docked first = always visible) ── -->
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0">

            <Rectangle Width="1" Height="12"
                       Fill="#14FFFFFF"
                       Margin="7,0,2,0"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0">
                <TextBlock x:Name="DateText"
                           Foreground="#7A8898"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="ClockText"
                           Foreground="#F2F4F7"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="ExitButton"
                    Content="&#xD7;"
                    Click="ExitButton_Click"
                    Width="28"
                    Height="24"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#585B5D"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            Width="28" Height="24"
                                            CornerRadius="7">
                                        <TextBlock x:Name="label"
                                                   Text="{TemplateBinding Content}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#CC2222"/>
                                            <Setter TargetName="label"  Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#991111"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

        <!-- ── CENTER GROUP ── launcher + separator + horizontally scrolling chips ── -->
        <Grid x:Name="CenterGrid" ClipToBounds="True">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LauncherPill"
                        Grid.Column="0"
                        Background="#0AFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="1,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FilesButton"
                                ToolTip="Files"
                                Style="{StaticResource LauncherButtonStyle}"
                                Click="FilesButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 1,4 L 6,4 L 7.5,5.5 L 15,5.5 L 15,13 L 1,13 Z"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="WebButton"
                                ToolTip="Web"
                                Style="{StaticResource LauncherButtonStyle}"
                                Click="WebButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Grid Width="16" Height="16">
                                    <Ellipse Margin="1"
                                             Fill="Transparent"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.2"/>
                                    <Path Data="M 8,1.5 C 5.5,4.2 5.5,11.8 8,14.5 M 8,1.5 C 10.5,4.2 10.5,11.8 8,14.5 M 1.5,8 L 14.5,8"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.1"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Button x:Name="CodeButton"
                                ToolTip="VS Code"
                                Style="{StaticResource LauncherButtonStyle}"
                                Click="CodeButton_Click">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 6,3 L 2,8 L 6,13 M 10,3 L 14,8 L 10,13"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>

                <Rectangle x:Name="ChipSeparator"
                           Grid.Column="1"
                           Width="1" Fill="#14FFFFFF"
                           Margin="7,8,9,8" VerticalAlignment="Stretch"/>

                <Grid x:Name="WindowChipsOverlayGrid"
                      Grid.Column="2">
                    <ScrollViewer x:Name="WindowChipsScrollViewer"
                                  AllowDrop="True"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  DragOver="WindowChipsScrollViewer_DragOver"
                                  DragLeave="WindowChipsScrollViewer_DragLeave"
                                  Drop="WindowChipsScrollViewer_Drop"
                                  ScrollChanged="WindowChipsScrollViewer_ScrollChanged"
                                  PreviewMouseWheel="WindowChipsScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="WindowChips"
                              VerticalAlignment="Center"
                              ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="{Binding ChipGapWidth}"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="1"
                                           Width="1" Height="10"
                                           Fill="#1AFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            <Button Grid.Column="0"
                                    Content="{Binding Title}"
                                    Tag="{Binding Handle}"
                                    ToolTip="{Binding ToolTipText}"
                                    Width="{Binding Width}"
                                    Margin="0"
                                    Padding="{Binding ChipPadding}"
                                    ContextMenuService.Placement="Bottom"
                                    ContextMenuOpening="ChipButton_ContextMenuOpening"
                                    PreviewMouseLeftButtonDown="ChipButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="ChipButton_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="ChipButton_PreviewMouseMove"
                                    PreviewMouseDown="ChipButton_PreviewMouseDown"
                                    MouseEnter="ChipButton_MouseEnter"
                                    MouseLeave="ChipButton_MouseLeave"
                                    Click="ChipButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ChipContextMenuStyle}"
                                                 Opened="ChipContextMenu_Opened">
                                        <MenuItem Header="Minimize"
                                                  Tag="minimize"
                                                  Style="{StaticResource ChipContextMenuItemStyle}"
                                                  Click="ChipMinimizeMenuItem_Click"/>
                                        <MenuItem Header="Restore"
                                                  Tag="restore"
                                                  Style="{StaticResource ChipContextMenuItemStyle}"
                                                  Click="ChipRestoreMenuItem_Click"/>
                                        <MenuItem Header="Close"
                                                  Style="{StaticResource ChipContextMenuItemStyle}"
                                                  Click="ChipCloseMenuItem_Click"/>
                                        <MenuItem Header="Open New Window"
                                                  Tag="openNewWindow"
                                                  Style="{StaticResource ChipContextMenuItemStyle}"
                                                  Click="OpenNewWindowMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                        <Style.Triggers>
                                            <!-- IsMinimized first; IsActive overrides if both true -->
                                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                <Setter Property="Foreground" Value="#59C8CDD6"/>
                                                <Setter Property="Opacity" Value="0.68"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#293DDC97"/>
                                                <Setter Property="Foreground" Value="#EEF1F5"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <Rectangle x:Name="WindowChipDropCue"
                               Width="3" Height="16"
                               RadiusX="1" RadiusY="1"
                               Fill="#3DDC97"
                               Opacity="0.95"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                    <Rectangle x:Name="WindowChipsLeftFade"
                               Width="14"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False"
                               Visibility="Collapsed">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#D90A0C10" Offset="0"/>
                                <GradientStop Color="#900A0C10" Offset="0.40"/>
                                <GradientStop Color="#000A0C10" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="WindowChipsRightFade"
                               Width="14"
                               HorizontalAlignment="Right"
                               IsHitTestVisible="False"
                               Visibility="Collapsed">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#000A0C10" Offset="0"/>
                                <GradientStop Color="#900A0C10" Offset="0.60"/>
                                <GradientStop Color="#D90A0C10" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </Grid>
        </Grid>

        </DockPanel>
    </Border>
</Window>
