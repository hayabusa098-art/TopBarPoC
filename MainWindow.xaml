<Window x:Class="TopBarPoC.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Height="32"
        Width="1920"
        Title="TopBar"
        Background="#111111">
    <Window.Resources>

        <Style x:Key="LauncherButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#707070"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="label"
                                       Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="label"  Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="label" Property="Foreground" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#909090"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="9,0"/>
            <Setter Property="MaxWidth"        Value="130"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="label"
                                       Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="label"  Property="Foreground" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- 0: launcher -->
            <ColumnDefinition Width="Auto"/>  <!-- 1: separator -->
            <ColumnDefinition Width="*"/>     <!-- 2: window chips -->
            <ColumnDefinition Width="Auto"/>  <!-- 3: date / time -->
            <ColumnDefinition Width="Auto"/>  <!-- 4: exit -->
        </Grid.ColumnDefinitions>

        <!-- Launcher -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch">
            <Button x:Name="FilesButton"
                    Content="Files" ToolTip="Files"
                    Style="{StaticResource LauncherButtonStyle}"
                    Click="FilesButton_Click"/>
            <Button x:Name="WebButton"
                    Content="Web" ToolTip="Web"
                    Style="{StaticResource LauncherButtonStyle}"
                    Click="WebButton_Click"/>
            <Button x:Name="CodeButton"
                    Content="Code" ToolTip="VS Code"
                    Style="{StaticResource LauncherButtonStyle}"
                    Click="CodeButton_Click"/>
        </StackPanel>

        <!-- Separator between launcher and window chips -->
        <Rectangle Grid.Column="1"
                   Width="1" Fill="#2A2A2A"
                   Margin="2,8,2,8" VerticalAlignment="Stretch"/>

        <!-- Window chips -->
        <ItemsControl x:Name="WindowChips"
                      Grid.Column="2"
                      VerticalAlignment="Stretch"
                      ClipToBounds="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Title}"
                            Tag="{Binding Handle}"
                            Click="ChipButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                <Style.Triggers>
                                    <!-- IsMinimized first; IsActive overrides if both true -->
                                    <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                        <Setter Property="Foreground" Value="#505050"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Date / time -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,8,0">
            <TextBlock x:Name="DateText"
                       Foreground="#606060"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,7,0"/>
            <TextBlock x:Name="ClockText"
                       Foreground="#D0D0D0"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Exit -->
        <Button x:Name="ExitButton"
                Grid.Column="4"
                Content="&#xD7;"
                Click="ExitButton_Click"
                Width="32"
                Height="32"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        Width="32" Height="32">
                                    <TextBlock x:Name="label"
                                               Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#CC2222"/>
                                        <Setter TargetName="label"  Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#991111"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
