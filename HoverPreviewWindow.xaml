<Window x:Class="TopBarPoC.HoverPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="280" Height="185"
        Background="#0B1117">
    <Window.Resources>
        <LinearGradientBrush x:Key="PreviewWindowBackgroundBrush"
                             StartPoint="0.5,0"
                             EndPoint="0.5,1">
            <GradientStop Color="#192832" Offset="0"/>
            <GradientStop Color="#101920" Offset="0.18"/>
            <GradientStop Color="#0B1117" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PreviewWindowBorderBrush"
                             StartPoint="0.5,0"
                             EndPoint="0.5,1">
            <GradientStop Color="#52FFFFFF" Offset="0"/>
            <GradientStop Color="#24FFFFFF" Offset="0.14"/>
            <GradientStop Color="#14FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PreviewCardBackgroundBrush" Color="#111A21"/>
        <SolidColorBrush x:Key="PreviewCardHoverBrush" Color="#17232C"/>
        <SolidColorBrush x:Key="PreviewCardPressedBrush" Color="#0E171E"/>
        <SolidColorBrush x:Key="PreviewCardDividerBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="PreviewTitleStripBrush" Color="#E60D151B"/>
        <SolidColorBrush x:Key="PreviewTitleForegroundBrush" Color="#D9E5E9EB"/>
        <SolidColorBrush x:Key="PreviewBadgeBackgroundBrush" Color="#E616222A"/>
        <SolidColorBrush x:Key="PreviewBadgeBorderBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="PreviewBadgeForegroundBrush" Color="#E8F1F4F5"/>
        <SolidColorBrush x:Key="PreviewCloseForegroundBrush" Color="#AAB6BCC0"/>
        <SolidColorBrush x:Key="PreviewCloseHoverBrush" Color="#C9484C"/>
        <SolidColorBrush x:Key="PreviewClosePressedBrush" Color="#A93438"/>

        <Style x:Key="PreviewCardCloseButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource PreviewCloseForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="18"/>
            <Setter Property="Height"          Value="18"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PreviewCloseHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PreviewClosePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource PreviewWindowBackgroundBrush}"
            BorderBrush="{StaticResource PreviewWindowBorderBrush}"
            BorderThickness="1">
        <ItemsControl x:Name="CardsHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding Hwnd}"
                            Click="PreviewCard_Click"
                            Width="280"
                            Height="185"
                            Margin="0,0,10,0"
                            Background="{StaticResource PreviewCardBackgroundBrush}"
                            BorderBrush="{StaticResource PreviewCardDividerBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PreviewCardHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PreviewCardPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <!-- DWM renders thumbnail into the top row. -->
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Padding="7,2"
                                    Background="{StaticResource PreviewBadgeBackgroundBrush}"
                                    BorderBrush="{StaticResource PreviewBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverflowCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding OverflowCount, StringFormat=+{0}}"
                                           Foreground="{StaticResource PreviewBadgeForegroundBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{StaticResource PreviewTitleStripBrush}"
                                    BorderBrush="#16FFFFFF"
                                    BorderThickness="0,1,0,0"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Title}"
                                       Foreground="{StaticResource PreviewTitleForegroundBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="8,0,26,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Row="1"
                                    Style="{StaticResource PreviewCardCloseButtonStyle}"
                                    Content="&#xD7;"
                                    Click="PreviewCardClose_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
