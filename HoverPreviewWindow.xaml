<Window x:Class="TopBarPoC.HoverPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="280" Height="185"
        Background="#0E1318">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>   <!-- DWM renders thumbnail into this client-area strip -->
            <RowDefinition Height="22"/>  <!-- title strip -->
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText"
                   Grid.Row="1"
                   Foreground="#8CC8CDD6"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   VerticalAlignment="Center"
                   Margin="8,0"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
